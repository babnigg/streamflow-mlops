# Copy this file to .env and fill in real values. .env is gitignored -- never
# commit real credentials.
#
# Points streamflow.tune / streamflow.train at a remote MLflow tracking
# server (e.g. DagsHub) instead of the local ./mlruns file store. Leave
# unset / delete .env to keep using the local store.
#
# Get these from your DagsHub repo: Remote > Experiments > MLflow, and a
# token from https://dagshub.com/user/settings/tokens
MLFLOW_TRACKING_URI=https://dagshub.com/<owner>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<owner>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>
